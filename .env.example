# Bu dosya bir ŞABLONdur, güvenle Git'e eklenip paylaşılabilir.
#
# GERÇEK anahtarını buraya YAZMA. Bunun yerine:
# 1) Bu dosyayı ".env" adıyla kopyala (aynı klasöre, PlanToPlate'in kök dizinine).
# 2) Aşağıdaki değeri kendi Gemini API anahtarınla değiştir.
# 3) ".env" dosyası .gitignore'da olduğu için asla Git'e eklenmez/paylaşılmaz.
#
# Ücretsiz bir API anahtarı almak için: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=BURAYA_KENDI_GEMINI_API_ANAHTARINI_YAPISTIR

# RevenueCat panelinden (https://app.revenuecat.com) alacağın, Android
# projene özel "Public API Key". Hesap oluşturmadan önce boş bırakabilirsin;
# boşken uygulama Premium satın alma özelliğini sessizce devre dışı bırakır,
# çökmez.
REVENUECAT_API_KEY=BURAYA_KENDI_REVENUECAT_ANDROID_ANAHTARINI_YAPISTIR

# Google AdMob panelinden (https://admob.google.com) alacağın GERÇEK banner
# ve ödüllü video reklam birimi kimlikleri. NOT: Bunlar sadece RELEASE
# (yayın) modunda kullanılır; geliştirme sırasında (`flutter run`) uygulama
# GÜVENLİK GEREĞİ her zaman Google'ın test kimliklerini kullanır (bkz.
# lib/data/services/ads_service.dart). Boş bırakırsan release modda bile
# test kimlikleri kullanılmaya devam eder, uygulama çökmez.
ADMOB_BANNER_AD_UNIT_ID=BURAYA_KENDI_ADMOB_BANNER_REKLAM_BIRIMI_KIMLIGINI_YAPISTIR
ADMOB_REWARDED_AD_UNIT_ID=BURAYA_KENDI_ADMOB_ODULLU_REKLAM_BIRIMI_KIMLIGINI_YAPISTIR
