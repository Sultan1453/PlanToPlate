# Bu dosya bir ŞABLONdur, güvenle Git'e eklenip paylaşılabilir.
#
# GERÇEK anahtarını buraya YAZMA. Bunun yerine:
# 1) Bu dosyayı ".env" adıyla kopyala (PlanToPlate kök dizinine).
# 2) Aşağıdaki değerleri kendi anahtarlarınla değiştir.
# 3) ".env" .gitignore'dadır — Git'e eklenmez.
# 4) Çalıştırırken APK'ya gömülmez; scripts ile dart-define verilir:
#      .\scripts\run_dev.ps1
#      .\scripts\build_aab.ps1
#
# Ücretsiz Gemini anahtarı: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=BURAYA_KENDI_GEMINI_API_ANAHTARINI_YAPISTIR

# RevenueCat Android Public API Key (secret key değil).
REVENUECAT_API_KEY=BURAYA_KENDI_REVENUECAT_ANDROID_ANAHTARINI_YAPISTIR

# AdMob birim kimlikleri — yalnızca RELEASE derlemede kullanılır.
ADMOB_BANNER_AD_UNIT_ID=BURAYA_KENDI_ADMOB_BANNER_REKLAM_BIRIMI_KIMLIGINI_YAPISTIR
ADMOB_REWARDED_AD_UNIT_ID=BURAYA_KENDI_ADMOB_ODULLU_REKLAM_BIRIMI_KIMLIGINI_YAPISTIR

# Sentry crash raporlama. Boş bırakırsan Sentry kapalıdır.
# https://sentry.io → Project → Client Keys (DSN)
SENTRY_DSN=

# Yayınladığın gizlilik politikası URL'si (Ayarlar'da link olarak açılır).
# Şablon: docs/privacy_policy_tr.md
PRIVACY_POLICY_URL=

# Online market affiliate / deep link takip parametreleri.
AFFILIATE_REF_ID=
AFFILIATE_TAG=plantoplate
